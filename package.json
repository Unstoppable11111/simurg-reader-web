{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:test": "nuxt build --dotenv .env.test",
    "build:prod": "nuxt build --dotenv .env.production",
    "postbuild": "npm run clean:archives",
    "postbuild:test": "npm run clean:archives",
    "postbuild:prod": "npm run clean:archives",
    "dev": "nuxt dev --dotenv .env.development",
    "dev:test": "nuxt dev --dotenv .env.test",
    "generate": "nuxt generate",
    "postgenerate": "npm run clean:archives",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "clear": "nuxt build --clean",
    "clean:archives": "node --input-type=module -e \"import { readdirSync, rmSync } from 'node:fs'; for (const f of readdirSync('.')) { if (/\\\\.tar(\\\\.gz)?$/.test(f)) rmSync(f, { force: true }); }\""
  },
  "dependencies": {
    "@ckeditor/ckeditor5-vue": "^7.3.0",
    "@pinia/nuxt": "^0.11.2",
    "@tinymce/tinymce-vue": "^6.3.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/three": "^0.182.0",
    "axios": "^1.13.2",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "element-plus": "^2.11.1",
    "lucide-vue-next": "^0.544.0",
    "nuxt": "^4.0.3",
    "pinia": "^3.0.3",
    "reka-ui": "^2.8.0",
    "swiper": "^11.2.10",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.182.0",
    "tinymce": "^8.0.2",
    "vue": "^3.5.18",
    "vue-cropper": "^0.6.5",
    "vue-router": "^4.5.1",
    "vue3-emoji": "^3.0.5"
  },
  "devDependencies": {
    "@element-plus/nuxt": "^1.1.4",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@types/node": "^25.0.3",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "postcss-px-to-viewport": "^1.1.1",
    "sass-embedded": "^1.90.0",
    "tailwindcss": "^3.4.17",
    "unplugin-auto-import": "^20.0.0",
    "unplugin-vue-components": "^29.0.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-svg-loader": "^5.1.0"
  }
}
